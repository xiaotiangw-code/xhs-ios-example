<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        xhs-ios-examples：调用 xhs-ios-sign-app 的设备托管 API 的示例工程。
        纯 HTTP 示例，无数据库 / Redis / Spring。每个示例一个包（一个文件夹），
        公共注册设备 / 签名 / 平台鉴权 / HTTP 工具 / URL 常量收敛到 common 包。
    -->
    <groupId>com.mayn.xhs</groupId>
    <artifactId>xhs-ios-examples</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>xhs-ios-examples</name>
    <description>调用 xhs-ios-sign-app 设备托管 API 的示例工程</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <okhttp.version>4.9.3</okhttp.version>
        <json.version>20210307</json.version>
    </properties>

    <dependencies>
        <!-- HTTP 客户端 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <!-- JSON 解析（响应统一是 {code,msg,data}） -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${json.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>